{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealguard.local/schemas/condition_met.json",
  "title": "DealGuard condition_met evidence",
  "type": "object",
  "required": ["dealUrl", "signature", "amount", "condition_met"],
  "properties": {
    "dealUrl": {
      "type": "string",
      "pattern": "^https://",
      "description": "HTTPS URL of the deal listing or delivery page used as evidence"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{8,130}$",
      "description": "Hex attestation over deal_id|dealUrl|amount"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Escrow amount as decimal integer string"
    },
    "condition_met": {
      "type": "boolean",
      "description": "True if frozen evidence supports paying the provider"
    },
    "metadata": {
      "type": "object",
      "description": "Optional deal_id, notes, listing_hash, commit",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
